# Backend (server/). Sao chép thành .env khi cần; node --env-file-if-exists=.env tự nạp.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/app.db
# Bắt buộc đặt khi triển khai; dev để trống thì server tạo ngẫu nhiên mỗi lần chạy (cookie cũ mất hiệu lực).
SESSION_SECRET=
# Tạo admin đầu tiên khi bảng users chưa có admin. Thiếu mật khẩu: server tạo ngẫu nhiên và in ra console một lần.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LOG_RETENTION_DAYS=90
LOG_IP_MASK=0
TRUST_PROXY=0
# NODE_ENV=production thì phục vụ dist/ kèm SPA fallback từ cùng tiến trình.
# STATIC_DIR=dist
CONSENT_VERSION=2026-09-17
