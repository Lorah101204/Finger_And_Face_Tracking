{
  "name": "finger-and-face-tracking",
  "private": true,
  "version": "0.0.0",
  "description": "Web Camera Tracking: a white pixel grid where the reveal region is the convex hull of your fingertips; face landmarks and person/mannequin classification run only on the revealed crop, entirely in the browser",
  "homepage": "https://lorah101204.github.io/Finger_And_Face_Tracking/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorah101204/Finger_And_Face_Tracking.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:boundaries": "eslint -c eslint.boundaries.config.js \"src/face/**/*.ts\" \"src/classify/**/*.ts\" \"src/dataset/**/*.ts\" \"src/log/**/*.ts\"",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=reports/unit.json && playwright test && node tools/test-report.mjs",
    "test:report:write": "node tools/test-report.mjs",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "test:bench": "playwright test -c playwright.bench.config.ts",
    "test:deploy": "playwright test -c playwright.deploy.config.ts",
    "bench:report": "node tools/benchmark-report.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "check:invariants": "node tools/check-invariants.mjs",
    "models:fetch": "node tools/fetch-models.mjs",
    "spikes:fetch": "node tools/fetch-spike-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "mermaid": "^12.0.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
